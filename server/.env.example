# Copy to server/.env and fill in. server/.env is git-ignored. Every value here is
# validated at boot (src/config/env.ts); the server refuses to start if one is wrong.
# Where to find each Supabase value: docs/SUPABASE_SETUP.md.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Reverse proxies in front of the API (0 locally; usually 1 behind a load balancer).
TRUST_PROXY=0

# Leave unset locally. Behind Cloudflare (Render): cf-connecting-ip, the visitor's IP for
# rate limits.
# CLIENT_IP_HEADER=cf-connecting-ip

# Browser origins allowed to call the API, comma-separated, exact (no trailing slash).
# Empty locally (the Vite dev proxy makes calls same-origin). Required in production:
# the site's origin(s), e.g. https://the-blue-bridge.vercel.app
CORS_ORIGINS=

# SECRET. Supabase Dashboard > Connect > Session pooler (or Direct). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_POOL_MAX=10
# Path to the Supabase root certificate (Database Settings > SSL Configuration).
# Required in production. When set, leave sslmode out of DATABASE_URL.
DATABASE_SSL_CA_PATH=

# Public. Supabase Dashboard > Settings > API Keys (Project URL).
SUPABASE_URL=https://your-project-ref.supabase.co
# SECRET. Settings > API Keys > Secret keys (sb_secret_...). Server only, never the browser.
SUPABASE_SECRET_KEY=
