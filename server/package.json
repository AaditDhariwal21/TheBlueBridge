{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning src/index.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning src/scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning src/scripts/seed.ts",
    "db:migrate:prod": "node --env-file=.env.production.local --experimental-strip-types --disable-warning=ExperimentalWarning src/scripts/migrate.ts",
    "db:seed:prod": "node --env-file=.env.production.local --experimental-strip-types --disable-warning=ExperimentalWarning src/scripts/seed.ts",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning \"src/**/*.test.ts\"",
    "test:integration": "node --env-file=test/integration.env --test --experimental-strip-types --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "test:db:up": "docker compose -f test/compose.yaml up -d --wait",
    "test:db:down": "docker compose -f test/compose.yaml down"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  }
}
