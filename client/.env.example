# Public build settings. Everything here ends up in the browser bundle, so it must never
# contain a secret. Put your local values in client/.env.local (git-ignored via *.local);
# client/.env (committed) holds only VITE_SITE_URL.

# Canonical origin for <link rel="canonical"> and Open Graph URLs.
VITE_SITE_URL=https://the-blue-bridge.vercel.app

# Supabase Dashboard > Settings > API Keys. See docs/SUPABASE_SETUP.md.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The PUBLISHABLE key (sb_publishable_...). Never the secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Production only (set on Vercel): the API's origin, no trailing slash, no /api.
# Leave unset locally: Vite proxies /api to the local server.
# VITE_API_URL=https://the-blue-bridge-api.onrender.com
